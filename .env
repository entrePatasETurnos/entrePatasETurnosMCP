# Copy to .env and fill in. Never commit .env.
# --- Required ---
MCP_API_BASE_URL=http://localhost:8080
MCP_PUBLIC_BASE_URL=http://localhost:8000
MCP_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Secrets: leave empty here; set in .env only.
MCP_GOOGLE_CLIENT_SECRET=
MCP_REDIS_URL=
# base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MCP_TOKEN_ENCRYPTION_KEY=
# --- Optional ---
MCP_API_TIMEOUT_SECONDS=10
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
